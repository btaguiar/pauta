# Pauta — copie para .env e preencha. Nunca comite o .env.

# Chat: Model Studio da Alibaba, em modo compatível com o protocolo da OpenAI.
# API_KEY_ALIBABA também é aceito como nome desta chave. Com os dois
# preenchidos, vale CHAT_API_KEY.
CHAT_API_KEY=
CHAT_BASE_URL=https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1

# Embedding: gateway separado, porque o de chat não serve modelo de embedding.
# Medido em 2026-09-25: a lista de /models não traz nenhum, e /embeddings recusa
# text-embedding-v4, text-embedding-v3 e text-embedding-3-small. Medido de novo
# em 2026-09-28: 404 também para text-embedding-v2, v1, qwen3-embedding e
# multimodal-embedding-v1, e a chave do plano de chat dá 401 no dashscope-intl.
# Duas chaves, então, e é o preço de o índice do corpus não depender do plano de
# chat.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1

TAVILY_API_KEY=

# Busca web. SEARCH_PROVIDER=ddgs nao exige chave e nao custa. SEARCH_PROVIDER=
# tavily exige TAVILY_API_KEY preenchida, e o startup falha dizendo qual variavel
# falta. O pacote ddgs declara "for educational purposes only" na propria pagina
# do PyPI, e isso e exposicao assumida, registrada na ADR 008.
SEARCH_PROVIDER=ddgs
# Regiao da busca. Default br-pt por decisao, nao pelo default do pacote, que e
# us-en. O golden set e em portugues.
SEARCH_REGION=br-pt
# Engine do metasearch. auto deixa o ddgs escolher e quebra comparabilidade entre
# rodadas. Fixar o engine e o que torna dois artefatos comparaveis.
SEARCH_BACKEND=auto
# Teto efetivo da chamada de busca, em segundos. Ver comentario em config.py.
WEB_SEARCH_TIMEOUT_S=10

# Modelos por papel (ADR 007). Nenhum default no código.
# O id do gateway de chat é nu, sem a casa de origem: qwen3.8-flash, glm-5.3,
# deepseek-v4-pro. O do gateway de embedding leva a casa: openai/...
#
# Os 11 modelos de texto que o plano libera, listados por /models em 2026-09-25
# e testados de novo em 2026-09-28, um pedido de chat e um de tool call cada.
# Todos responderam 200 e chamaram a tool com os argumentos certos. Latência do
# chat com max_tokens=1500, n=1, então serve para achar quebra, não para ranquear:
#
#   modelo                   chat   tool call
#   auto                     3,3s   ok   (roteador do gateway)
#   deepseek-v4-flash-0731   3,5s   ok
#   deepseek-v4-pro          4,2s   ok
#   deepseek-v4.1-flash      3,1s   ok
#   glm-5.2                  4,3s   ok
#   glm-5.3                  3,3s   ok
#   qwen3.6-flash            4,2s   ok
#   qwen3.7-max              4,9s   ok
#   qwen3.7-plus             5,5s   ok
#   qwen3.8-flash            3,5s   ok
#   qwen3.8-max              3,9s   ok
#
# Com max_tokens=20, cinco deles devolveram texto vazio: deepseek-v4-flash-0731,
# deepseek-v4-pro, deepseek-v4.1-flash, glm-5.2 e auto gastam o teto
# raciocinando antes de responder. Não ponha teto baixo de saída nesses.
# O /models também lista qwen-audio-3.0-realtime-plus, qwen-audio-3.0-tts-plus,
# wan2.7-image e wan2.7-image-pro, que não são de texto e o grafo não usa.
#
# ESCOLHA PROVISÓRIA, AINDA NÃO MEDIDA PELA MATRIZ. É a linha base-barata de
# eval/matrix.json, preenchida em 2026-09-28 para quem clonar conseguir rodar
# sem inventar a escolha. O supervisor em glm-5.3 é decisão de 2026-09-26. Worker
# e critic em qwen3.6-flash são o ponto de partida barato, e a matriz existe para
# dizer se o modelo caro se paga em algum papel. Quando `uv run python
# eval/matrix.py` rodar completa, troque este comentário pelo número que
# justificou a escolha e registre uma ADR no ARCHITECTURE.md.
MODEL_WORKER=qwen3.6-flash
MODEL_ROUTER=glm-5.3
MODEL_CRITIC=qwen3.6-flash
# Embedding mantido em 2026-09-28, por decisão e não por medição: é o modelo
# com que o corpus foi indexado, e o custo de indexar samples/ inteiro fica em
# torno de US$ 0,0004 (estimativa, cerca de 18 mil tokens a US$ 0,02/Mtok).
EMBEDDING_MODEL=openai/text-embedding-3-small

# Juiz do eval: precisa ser de um provider DIFERENTE do executor, para evitar
# viés de auto-preferência. O gateway de chat serve Qwen, GLM e DeepSeek, então
# isso é trocar a casa no id, com a mesma CHAT_API_KEY.
JUDGE_MODEL=

# Banco (checkpointer e contador de orçamento diário).
# Credencial de desenvolvimento local, idêntica à do docker-compose.yml.
# Se mudar aqui, mude lá no mesmo commit. Em produção vem do ambiente.
DATABASE_URL=postgresql://pauta:pauta@localhost:5432/pauta

# Comportamento do grafo
HITL_MODE=auto
MAX_SUPERVISOR_STEPS=8
MAX_CRITIC_LOOPS=2
# Voltas do research sem achar nada antes de a run desistir e o writer dizer
# o que faltou. Medido: sem teto, uma tarefa sem resposta no corpus repetiu
# research 4 vezes e gastou 58 mil tokens sem produzir briefing.
MAX_EMPTY_RESEARCH=2
BUDGET_TOKENS_PER_RUN=60000
# Parte do orçamento que só o writer gasta: os outros nós param antes dela.
# Medido em 2026-09-28: o writer gastou 13.685 tokens sobre 47 descobertas
# (n=1). 15000 é estimativa com folga sobre essa medição.
WRITER_RESERVE_TOKENS=15000
# Medido em 2026-09-26, em execuções reais do golden set contra o gateway de
# chat atual (Model Studio da Alibaba): supervisor 2,8 a 10,7s; research
# completou em torno de 130s com busca web, depois de estourar o teto de 90s
# herdado do gateway anterior; analyst estourou 90s; critic estourou 45s.
# Writer não foi medido neste gateway: 120s é estimativa com folga, não medida.
NODE_TIMEOUT_SUPERVISOR_S=30
NODE_TIMEOUT_RESEARCH_S=240
NODE_TIMEOUT_WRITER_S=120
NODE_TIMEOUT_CRITIC_S=150
NODE_TIMEOUT_ANALYST_S=240
NODE_RETRIES=2
MAX_TOOL_ROUNDS=3

# Retriever
RETRIEVER_TOP_K=5
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# Preço por milhão de tokens da combinação que você mediu. Vazio significa
# que o relatório mostra tokens e não calcula custo.
COST_PER_MTOK_USD=

# Guardrails da API pública
DAILY_BUDGET_USD=5.00
RATE_LIMIT_PER_IP=3/hour

# Trace opcional, desligado por padrao
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=pauta
