# Pauta — copie para .env e preencha. Nunca comite o .env.

# Providers
OPENAI_API_KEY=
TAVILY_API_KEY=

# Modelos por papel (ADR 007). Nenhum default no código.
MODEL_WORKER=
MODEL_ROUTER=
MODEL_CRITIC=
EMBEDDING_MODEL=

# Juiz do eval: precisa ser de um provider DIFERENTE do executor,
# para evitar viés de auto-preferência. A credencial do juiz vem da
# variável padrão do provider dele (ANTHROPIC_API_KEY, GOOGLE_API_KEY, etc.),
# não de uma variável própria: o run_eval.py instancia o juiz com
# init_chat_model, igual aos demais papéis.
JUDGE_MODEL=

# Banco (checkpointer e contador de orçamento diário).
# Credencial de desenvolvimento local, idêntica à do docker-compose.yml.
# Se mudar aqui, mude lá no mesmo commit. Em produção vem do ambiente.
DATABASE_URL=postgresql://pauta:pauta@localhost:5432/pauta

# Comportamento do grafo
HITL_MODE=auto
MAX_SUPERVISOR_STEPS=8
MAX_CRITIC_LOOPS=2
BUDGET_TOKENS_PER_RUN=60000
NODE_TIMEOUT_S=20
NODE_RETRIES=2

# Retriever
RETRIEVER_TOP_K=5
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# Guardrails da API pública
DAILY_BUDGET_USD=5.00
RATE_LIMIT_PER_IP=3/hour

# Trace opcional, desligado por padrao
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=pauta
